# Copy to .env (gitignored). Never commit real values.
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=odoo
ODOO_USER=ai_agent          # a dedicated limited Odoo user, NOT admin (see README)
ODOO_PASSWORD=change-me

# Two different secrets: the chat caller can never approve its own proposals.
AGENT_TOKEN=change-me-agent
APPROVER_TOKEN=change-me-approver

GEMINI_BASE=https://<gateway>/v1beta/models
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.5-flash

DB_PATH=./agent.db
PROPOSAL_TTL_SECONDS=900
HIGH_VALUE_THRESHOLD=50000
